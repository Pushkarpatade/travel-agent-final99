# =============================================================================
# TravelPilot Enterprise Production Environment Configuration
# Copy this file to .env and fill in your secrets. NEVER commit .env to GitHub.
# =============================================================================

ENVIRONMENT=development  # development | staging | production

# --- AI Model Providers ---
# Google Gemini (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Groq Fast Fallback (https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI Fallback
OPENAI_API_KEY=

# --- Search & External Services ---
# Tavily Web Search API (https://tavily.com/)
TAVILY_API_KEY=your_tavily_api_key_here

# Google Maps Geocoding & Places (Optional)
GOOGLE_MAPS_API_KEY=

# OpenWeatherMap (Optional)
WEATHER_API_KEY=

# --- LangSmith Observability & Tracing ---
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=travelpilot-multiagent

# --- Managed Database (Supabase PostgreSQL / Local SQLite) ---
# Local SQLite Default:
DATABASE_URL=sqlite:///./travelpilot.db
# Production Supabase PostgreSQL:
# DATABASE_URL=postgresql://postgres.xxx:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# --- Redis Cache & Queue (Upstash / Redis Cloud) ---
REDIS_URL=redis://localhost:6379/0

# --- Security & JWT Authentication ---
JWT_SECRET=generate-a-strong-64-character-hex-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Email OTP Dispatcher (Resend.com) ---
RESEND_API_KEY=your_resend_api_key_here

# --- Rate Limiting ---
RATE_LIMIT_PER_MINUTE=60
AUTH_RATE_LIMIT_PER_MINUTE=10
PLANNING_RATE_LIMIT_PER_MINUTE=5

# --- Error Tracking ---
SENTRY_DSN=
